            "updated_date": "={{ $fromAI('updated_date','Last update date, ISO 8601; use the current date','string') }}"
          },
          "schema": [
            {"id":"project_name","displayName":"project_name","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},
            {"id":"entry_type","displayName":"entry_type","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},
            {"id":"content","displayName":"content","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},
