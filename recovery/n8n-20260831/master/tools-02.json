            "decision": "={{ $fromAI('decision','Decision recorded, if any','string') }}",
            "open_question": "={{ $fromAI('open_question','Open question, if any','string') }}",
            "current_state": "={{ $fromAI('current_state','Current state of the project/task','string') }}",
