[
  {
    "type": "node",
    "name": "write_knowledge_memory",
    "description": "Insert or update (upsert, matched on topic) a row in GABR_KNOWLEDGE_MEMORY. Use to persist a known fact per Skill 12 KNOWLEDGE classification, always recording confidence and source. Set created_date to the current date (ISO 8601). Never store an assumption or inference as a VERIFIED_FACT; use an honest classification/confidence. Operational persistent memory, not model retraining. Cannot delete rows.",
    "node": {
      "nodeType": "n8n-nodes-base.dataTableTool",
      "nodeTypeVersion": 1.1,
      "nodeParameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": {"__rl":true,"mode":"id","value":"9fWq7oo8awRw1m8f"},
        "matchType": "allConditions",
        "filters": {"conditions":[{"keyName":"topic","condition":"eq","keyValue":"={{ $fromAI('topic','Topic to match/insert','string') }}"}]},
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["topic"],
          "value": {
            "topic": "={{ $fromAI('topic','Topic of the knowledge entry','string') }}",
            "content": "={{ $fromAI('content','The knowledge content','string') }}",
            "classification": "={{ $fromAI('classification','Classification per Skill 12 (e.g. FACT, INFERENCE, HYPOTHESIS); never label an assumption as VERIFIED_FACT','string') }}",
            "confidence": "={{ $fromAI('confidence','Confidence level, e.g. high/medium/low','string') }}",
            "source": "={{ $fromAI('source','Source of the knowledge','string') }}",
            "source_date": "={{ $fromAI('source_date','Date of the source, ISO 8601','string') }}",
            "created_date": "={{ $fromAI('created_date','Creation date, ISO 8601; use the current date','string') }}"
          },
          "schema": [
            {"id":"topic","displayName":"topic","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},
            {"id":"content","displayName":"content","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},
            {"id":"classification","displayName":"classification","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},
            {"id":"confidence","displayName":"confidence","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},
            {"id":"source","displayName":"source","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},
            {"id":"source_date","displayName":"source_date","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},
            {"id":"created_date","displayName":"created_date","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false}
          ]
        }
