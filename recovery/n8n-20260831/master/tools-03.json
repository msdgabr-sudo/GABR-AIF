        "filters": {"conditions":[{"keyName":"failure_summary","condition":"eq","keyValue":"={{ $fromAI('failure_summary','The failure_summary to look up','string') }}"}]},
        "returnAll": false,
        "limit": 50
      }
    }
  },
  {
    "type": "node",
    "name": "write_failure_memory",
