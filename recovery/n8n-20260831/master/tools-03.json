        "filters": {"conditions":[{"keyName":"failure_summary","condition":"eq","keyValue":"={{ $fromAI('failure_summary','Short failure summary to match/insert','string') }}"}]},
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["failure_summary"],
          "value": {
            "failure_summary": "={{ $fromAI('failure_summary','Short summary of the failure','string') }}",
