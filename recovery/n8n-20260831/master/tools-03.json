            "context_source": "={{ $fromAI('context_source','Context or source where the failure occurred','string') }}",
            "occurred_at": "={{ $fromAI('occurred_at','When the failure occurred, ISO 8601; use the current date','string') }}"
          },
          "schema": [
            {"id":"failure_summary","displayName":"failure_summary","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},
            {"id":"root_cause","displayName":"root_cause","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},
            {"id":"incorrect_assumption","displayName":"incorrect_assumption","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},
            {"id":"correction","displayName":"correction","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},
